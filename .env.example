# ==============================
# Required - LLM & Core Services
# ==============================

# OpenAI
OPENAI_API_KEY=

# Kiwoom Securities (REST)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# Naver Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Tavily Search API
TAVILY_API_KEY=

# Financial Data APIs
DART_API_KEY=
FRED_API_KEY=
ECOS_API_KEY=


# ==============================
# Optional - Runtime Toggles
# ==============================

# Logging & Debug
LOG_LEVEL=INFO
DEBUG=false

# Run modes
IS_DOCKER=false
# ⚠️ 주문 경로를 결정하는 단일 소스. false=키움 모의(mockapi), true=실거래.
#    모의투자 키일 땐 반드시 false — 키 종류와 어긋나면 8005/권한오류.
KIWOOM_PRODUCTION_MODE=false

# Dev container bind mode for source volume (ro|rw)
# Used by docker-compose.full.yml volumes with ${DEV_MODE:-ro}
DEV_MODE=ro


# ==============================
# Optional - Additional Providers
# ==============================

# Other LLMs (optional)
ANTHROPIC_API_KEY=

# Market data providers (optional)
FINNHUB_API_TOKEN=


# ==============================
# Optional - A2A Credentials (if enabling A2A auth)
# ==============================

A2A_BEARER_TOKEN=
A2A_API_KEY=
A2A_OAUTH2_CLIENT_ID=
A2A_OAUTH2_CLIENT_SECRET=


# ==============================
# Optional - Advanced Logging (MCP utils)
# ==============================

ENVIRONMENT=development
LOG_MASKING_LEVEL=partial
ENABLE_LOG_FILTERING=true
LOG_FILTERING_PERFORMANCE_MODE=false


# ==============================
# Compatibility (not required)
# ==============================

# Some validators accept this as an alternative name; primary is KIWOOM_ACCOUNT_NO
KIWOOM_ACCOUNT_NUMBER=

## LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default

# ==============================
# 추세추종 트랙 (scripts/trend_follow.py)
# ==============================
# ※ 아래 값들은 **코드 기본값과 동일**하다(scripts/trend_config.py).
#   .env 는 override 전용 — 이 파일이 없어도 검증된 전략 그대로 동작한다.
#   기본값을 바꾸려면 trend_config.py 와 tests/test_trend_config.py 를 함께 고칠 것.

# 알림 (선택). CRITICAL 은 매도거부/누적실패/가드위반 등 즉시대응분만 별도 채팅으로.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CRITICAL_CHAT_ID=

# 유니버스 — watchdog 기본값(trend_watchdog.py)과 반드시 일치시킬 것
TREND_UNIVERSE=largecap          # largecap | watchlist | gainers(보류)
TREND_WATCHLIST=005930,000660
TREND_TOP_N=100

# 진입
TREND_ENTRY_TIME=11:00           # SCHEDULE 이 이 값으로 구성됨
TREND_ENTRY_CUTOFF=14:00         # 하락보류 후보 재시도 마감 (ENTRY_TIME 보다 뒤여야 의미 있음)
TREND_MAX_POS=5
TREND_PULLBACK_PCT=12            # A/B(2026-06-26) 채택. 3 은 멜트업장에서 후보 0 빈발
TREND_PULLBACK_MIN_PCT=0          # 눌림목 하한: 0=MA20 이상만(2026-08-25 A/B) / off=하한없음

# 사이징 — risk = 예탁 RISK_PCT% ÷ 손절폭 (터틀식 거래별 리스크 균등)
TREND_SIZING_MODE=risk           # risk | pct_equity | fixed
TREND_RISK_PCT=1.5
TREND_MAX_NOTIONAL_PCT=25
TREND_POSITION_PCT=15            # risk 폴백(손절폭 무효/조회실패 시)

# 청산
TREND_EXIT_MA=120                # A/B(2026-06-12) 채택. MA50 대비 기대값 2~4배
TREND_MAX_HOLD=60                # 영업일 시간청산(백테스트 max_hold 와 정합)
TREND_HARD_STOP_PCT=10           # 0 = 하드손절 없음
TREND_FOREIGN_TREND_MA=20        # 외인 순매도 AND 종가<MA20 일 때만 청산 (2026-08-25 A/B)

# 안전장치 — 전부 0/off 가 아닌 값이 기본이다(0 이면 LIVE-GUARD 경고)
TREND_DAILY_LOSS_LIMIT_PCT=2     # 당일 실현손실 > 예탁 X% 시 신규진입 중단
TREND_BREADTH_MIN_PCT=0.4        # 당일 상승종목 비율 하한
TREND_REGIME_MA=60               # KOSPI < MA60 이면 신규진입 전면 차단
TREND_ADOPT_MODE=off             # all 이면 HTS 수동매수분도 trend 청산룰로 처분됨
TREND_PYRAMID_ADDS=0             # 피라미딩(승자 불타기) 종목당 추가 유닛 수

# 거래비용 (편도 bps) — 미설정 시 src/mcp_servers/trend_mcp/costs.py 값(백테스트와 단일 소스)
# TREND_TAX_BPS=20
# TREND_FEE_BPS=1.5
# TREND_SLIPPAGE_BPS=10
